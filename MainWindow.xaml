<Window x:Class="TapSynth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TapSynth.ViewModels"
        Title="TapSynth!" Height="780" Width="480"
        Background="#1B1E23" WindowStyle="ToolWindow" ResizeMode="CanMinimize"
        KeyDown="Window_KeyDown" Closed="Window_Closed" MouseWheel="Window_MouseWheel">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PadStyle" TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Background" Value="#31353F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E55151"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="180" />
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Device Selection Top Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-15,0,0">
            <TextBlock Text="IN:" Foreground="#888" FontSize="10" VerticalAlignment="Center"/>
            <ProgressBar Value="{Binding InputLevel}" Maximum="100" Width="40" Height="10" Margin="5,0" Foreground="#E55151" BorderThickness="0" Background="#333"/>
            <ComboBox ItemsSource="{Binding InputDevices}" SelectedIndex="{Binding SelectedInputDevice}" Width="150" Height="20" FontSize="10" Margin="0,0,5,0"/>
            
            <TextBlock Text="OUT:" Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <ProgressBar Value="{Binding OutputLevel}" Maximum="100" Width="40" Height="10" Margin="5,0" Foreground="#47D16A" BorderThickness="0" Background="#333"/>
            <ComboBox ItemsSource="{Binding OutputDevices}" SelectedIndex="{Binding SelectedOutputDevice}" Width="150" Height="20" FontSize="10"/>
        </StackPanel>

        <!-- LCD Screen -->
        <Border Grid.Row="0" Background="#9FB9A2" CornerRadius="12" BorderBrush="#0F1113" BorderThickness="4" Margin="10,20,10,10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="TAP SYNTH" FontFamily="Segoe UI Black" FontSize="32" Opacity="0.8" Margin="0,0,10,0"/>
                    <Button Content="🎤 MIC" Command="{Binding ToggleAudioRecordCommand}" Background="{Binding AudioRecordButtonBackground}" Foreground="White" FontWeight="Bold" Padding="8,2" BorderThickness="0" Margin="0,0,10,0" Focusable="False">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="(?) Help" Command="{Binding ShowHelpCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Foreground="#222" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <TextBlock Text="{Binding SelectedTrackIndex, StringFormat='TRK {0:D2}'}" FontSize="28" FontWeight="Bold" Margin="0,0,20,0" Opacity="0.7"/>
                    
                    <Button Content="-" Command="{Binding AdjustBPMCommand}" CommandParameter="-1" Focusable="False" Width="20" Background="Transparent" BorderThickness="0"/>
                    <TextBlock Text="{Binding BPM, StringFormat='BPM {0}'}" FontSize="28" FontWeight="Bold" Opacity="0.7" Margin="5,0"/>
                    <Button Content="+" Command="{Binding AdjustBPMCommand}" CommandParameter="1" Focusable="False" Width="20" Background="Transparent" BorderThickness="0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <!-- Oscilloscope -->
                    <Border BorderBrush="#6B8570" BorderThickness="2" Background="#8BA590" CornerRadius="4" Margin="5,0" Width="204" Height="44">
                        <Canvas Width="200" Height="40" ClipToBounds="True">
                            <Polyline Points="{Binding WaveformPoints}" Stroke="#111" StrokeThickness="1.5" />
                        </Canvas>
                    </Border>
                    <!-- Spectrum -->
                    <Border BorderBrush="#6B8570" BorderThickness="2" Background="#8BA590" CornerRadius="4" Margin="5,0" Width="204" Height="44">
                        <Canvas Width="200" Height="40" ClipToBounds="True">
                            <Polygon Points="{Binding SpectrumPoints}" Fill="#2D4D3A" />
                        </Canvas>
                    </Border>
                </StackPanel>
                
                <!-- Single Line Status Text -->
                <Border Visibility="{Binding StatusVisibility}" Background="#7F9982" CornerRadius="4" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="{Binding StatusText}" Foreground="#222" FontWeight="Bold" FontSize="14" Padding="10,2"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Parameter Controls (Sliders) -->
        <Grid Grid.Row="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedTrackPitch, StringFormat='PITCH [A]: {0:F0} semi'}" Foreground="White" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <Slider Minimum="-24" Maximum="24" Value="{Binding SelectedTrackPitch}" LargeChange="1" SmallChange="1" Focusable="False" IsSnapToTickEnabled="True" TickFrequency="1"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedTrackVolume, StringFormat='VOL [B]: {0:F2}'}" Foreground="White" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <Slider Minimum="0" Maximum="2" Value="{Binding SelectedTrackVolume}" LargeChange="0.1" SmallChange="0.05" Focusable="False"/>
            </StackPanel>
        </Grid>

        <!-- 5x5 Pad Grid -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 16 Sequence Pads -->
            <ItemsControl Grid.RowSpan="4" Grid.ColumnSpan="4" ItemsSource="{Binding Steps}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding ToggleCommand}" CommandParameter="{Binding Index}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PadStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsFxModeActive, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                            <Setter Property="Background" Value="#CC9933"/>
                                            <Setter Property="Foreground" Value="#111"/>
                                        </DataTrigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#E55151"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Ellipse Width="35" Height="35" Fill="#D14747" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                <Ellipse Width="10" Height="10" Fill="#47D16A" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="-5" Visibility="{Binding IsPlayhead, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding DisplayText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Function Button Stack on Right (Col 4) -->
            <Button Grid.Row="0" Grid.Column="4" Content="SND" Command="{Binding ToggleSoundModeCommand}" Style="{StaticResource PadStyle}" Background="{Binding SoundButtonBackground}" FontSize="14"/>
            <Button Grid.Row="1" Grid.Column="4" Content="FX" Command="{Binding ToggleFxModeCommand}" Style="{StaticResource PadStyle}" Background="{Binding FxButtonBackground}" FontSize="14"/>
            <Button Grid.Row="2" Grid.Column="4" Content="SAVE" Command="{Binding ToggleSaveModeCommand}" Style="{StaticResource PadStyle}" Background="{Binding SaveButtonBackground}" FontSize="14"/>
            <Button Grid.Row="3" Grid.Column="4" Content="LOAD" Command="{Binding ToggleLoadModeCommand}" Style="{StaticResource PadStyle}" Background="{Binding LoadButtonBackground}" FontSize="14"/>
            <Button Grid.Row="4" Grid.Column="4" Content="{Binding PlayButtonText}" Command="{Binding TogglePlayCommand}" Style="{StaticResource PadStyle}" Background="#D14747" FontSize="14"/>

            <!-- Function Button Stack on Bottom (Row 4, Col 0-3) -->
            <Button Grid.Row="4" Grid.Column="0" Content="UNDO" Command="{Binding UndoCommand}" Style="{StaticResource PadStyle}" Background="#3A3A3A" FontSize="14"/>
            <Button Grid.Row="4" Grid.Column="1" Content="REDO" Command="{Binding RedoCommand}" Style="{StaticResource PadStyle}" Background="#3A3A3A" FontSize="14"/>
            <Button Grid.Row="4" Grid.Column="2" Content="BPM" Style="{StaticResource PadStyle}" Background="#2D4D44" FontSize="14"/>
            <Button Grid.Row="4" Grid.Column="3" Content="WRITE" Command="{Binding ToggleLiveLooperCommand}" Style="{StaticResource PadStyle}" Background="{Binding WriteButtonBackground}" FontSize="14"/>
        </Grid>
    </Grid>
</Window>
